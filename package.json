{
  "name": "irri-website",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test:integration": "node --test backend/tests/phase1.test.mjs",
    "test:unit": "node --test backend/tests/unit.test.mjs",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "postcss": "8.5.33",
    "@prisma/config": { "deepmerge-ts": "8.0.0" }
  }
}
