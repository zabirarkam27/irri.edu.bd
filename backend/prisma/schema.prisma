generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MODERATOR
}

enum Status {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum PersonType {
  ADMINISTRATION
  FACULTY
  STAFF
  RESEARCHER
}

enum MediaType {
  IMAGE
  DOCUMENT
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(EDITOR)
  isActive     Boolean     @default(true)
  mediaAssets  MediaAsset[]
  auditLogs    AuditLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([role])
}

model InstitutionProfile {
  id             String   @id @default(cuid())
  name           String
  nameBn         String?
  acronym        String
  location       String
  motto          String?
  mottoBn        String?
  mission        String
  missionBn      String?
  vision         String
  visionBn       String?
  establishedAt  Int?
  operationStart Int?
  domain         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ReleaseSettings {
  id String @id
  releaseOwner String?
  rollbackOwner String?
  alertDestination String?
  releaseStartsAt DateTime?
  releaseEndsAt DateTime?
  updatedAt DateTime @updatedAt
}

model Page {
  id              String   @id @default(cuid())
  title           String
  titleBn         String?
  slug            String   @unique
  content         String
  contentBn       String?
  excerpt         String?
  status          Status   @default(DRAFT)
  seoTitle        String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Person {
  departmentId String?
  department Department? @relation("AcademicPeople", fields: [departmentId], references: [id])
  education String?
  interests String?
  officialEmail String?
  headedUnits Department[] @relation("DepartmentHead")
  taughtCourses Course[] @relation("CourseInstructor")
  ledProjects ResearchProject[] @relation("ProjectLead")
  projects ResearchProject[] @relation("ProjectTeam")
  publications Publication[] @relation("PublicationContributors")
  id          String     @id @default(cuid())
  name        String
  nameBn      String?
  slug        String     @unique
  designation String
  bio         String?
  photoUrl    String?
  order       Int        @default(0)
  type        PersonType @default(ADMINISTRATION)
  status      Status     @default(PUBLISHED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type, status])
}

model Department {
  unitType String?
  objectives String?
  location String?
  photoUrl String?
  officialEmail String?
  headId String?
  head Person? @relation("DepartmentHead", fields: [headId], references: [id])
  people Person[] @relation("AcademicPeople")
  researchAreas ResearchArea[]
  researchProjects ResearchProject[]
  publications Publication[]
  news NewsPost[]
  id          String    @id @default(cuid())
  name        String
  nameBn      String?
  slug        String    @unique
  description String?
  status      Status    @default(DRAFT)
  programs    Program[]
  courses     Course[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Program {
  code String?
  programType String?
  deliveryMode String?
  objectives String?
  eligibility String?
  admissions String?
  applicationStatus String?
  officialEmail String?
  fileUrl String?
  id           String      @id @default(cuid())
  title        String
  titleBn      String?
  slug         String      @unique
  level        String
  duration     String?
  description  String?
  status       Status      @default(DRAFT)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  courses      Course[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
}

model Course {
  outcomes String?
  fileUrl String?
  instructorId String?
  instructor Person? @relation("CourseInstructor", fields: [instructorId], references: [id])
  prerequisites Course[] @relation("CoursePrerequisites")
  requiredBy Course[] @relation("CoursePrerequisites")
  id           String      @id @default(cuid())
  title        String
  titleBn      String?
  slug         String      @unique
  code         String?
  credits      Float?
  description  String?
  status       Status      @default(DRAFT)
  programId    String?
  program      Program?    @relation(fields: [programId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model NewsPost {
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id])
  id              String   @id @default(cuid())
  title           String
  titleBn         String?
  slug            String   @unique
  excerpt         String?
  content         String
  contentBn       String?
  status          Status   @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, publishedAt])
}

model Notice {
  id              String   @id @default(cuid())
  title           String
  titleBn         String?
  slug            String   @unique
  content         String
  contentBn       String?
  status          Status   @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, publishedAt])
}

model Event {
  academicCalendar Boolean @default(false)
  id              String   @id @default(cuid())
  title           String
  titleBn         String?
  slug            String   @unique
  content         String
  contentBn       String?
  venue           String?
  startsAt        DateTime
  endsAt          DateTime?
  status          Status   @default(DRAFT)
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, startsAt])
}

model GalleryAlbum {
  id          String         @id @default(cuid())
  title       String
  titleBn     String?
  slug        String         @unique
  description String?
  status      Status         @default(DRAFT)
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GalleryImage {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  caption   String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())
}

model Publication {
  publicationType String?
  editors String?
  authors String?
  keywords String?
  isbn String?
  issn String?
  doi String?
  publisher String?
  journal String?
  externalUrl String?
  photoUrl String?
  citation String?
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id])
  projectId String?
  project ResearchProject? @relation(fields: [projectId], references: [id])
  contributors Person[] @relation("PublicationContributors")
  id              String   @id @default(cuid())
  title           String
  titleBn         String?
  slug            String   @unique
  abstract        String?
  author          String?
  fileUrl         String?
  status          Status   @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ResearchArea {
  id String @id @default(cuid())
  title String
  titleBn String?
  slug String @unique
  description String?
  contentBn String?
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id])
  projects ResearchProject[]
  status Status @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([departmentId, status])
}

model ResearchProject {
  id String @id @default(cuid())
  title String
  titleBn String?
  slug String @unique
  description String?
  contentBn String?
  projectStatus String?
  startsAt DateTime?
  endsAt DateTime?
  publicFunding String?
  outputs String?
  areaId String?
  area ResearchArea? @relation(fields: [areaId], references: [id])
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id])
  leadId String?
  lead Person? @relation("ProjectLead", fields: [leadId], references: [id])
  team Person[] @relation("ProjectTeam")
  publications Publication[]
  status Status @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([areaId, status])
  @@index([departmentId, status])
  @@index([leadId])
}

enum AcademicAssetKind {
  REPOSITORY
  RESOURCE
}

enum AcademicAccess {
  PRIVATE
  PUBLIC
}

model AcademicAsset {
  id String @id @default(cuid())
  title String
  titleBn String?
  slug String @unique
  description String?
  contentBn String?
  kind AcademicAssetKind
  access AcademicAccess @default(PRIVATE)
  rightsStatement String?
  rightsEvidence String?
  rightsVerified Boolean @default(false)
  rightsApprovedBy String?
  rightsApprovedAt DateTime?
  language String?
  version String?
  fileUrl String @unique
  expiresAt DateTime?
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id])
  replacementId String?
  replacement AcademicAsset? @relation("AssetReplacement", fields: [replacementId], references: [id])
  supersedes AcademicAsset[] @relation("AssetReplacement")
  status Status @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([kind, status, access, expiresAt])
  @@index([categoryId])
}

model Category {
  academicAssets AcademicAsset[]
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model MediaAsset {
  id         String    @id @default(cuid())
  url        String
  filename   String
  mimeType   String
  size       Int
  type       MediaType
  altText    String?
  storageKey String?
  thumbnailKey String?
  uploadedBy String?
  uploader   User?     @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime  @default(now())
}

model CmsSlugRedirect {
  model    String
  oldSlug  String
  recordId String

  @@id([model, oldSlug])
  @@index([model, recordId])
}

model PublicationSchedule {
  model       String
  recordId    String
  scheduledAt DateTime
  scheduledBy String

  @@id([model, recordId])
  @@index([scheduledAt])
}

model MediaGarbage {
  key       String   @id
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}
